# AgroConnect - Supabase Configuration (Backend)
# Smart India Hackathon 2026 - Problem Statement 26132

# Project Supabase REST API & Auth URL
# Example: https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (found in Supabase Settings > API)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (used for administrative backend operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL Database Connection URL
# Found in Supabase Settings > Database > Connection string (URI)
# Note: psycopg3 handles both direct port 5432 and Supavisor connection pooler port 6543
# Example Direct: postgresql://postgres:YOUR_PASSWORD@db.your-project-id.supabase.co:5432/postgres
# Example Pooler: postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Leave empty or set to sqlite:///./agroconnect.db for local offline development fallback
DATABASE_URL=sqlite:///./agroconnect.db
